# Copy as frontend/.env.local; never commit the actual .env.local file.
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Internal FastAPI URL: when BOTH apps run via Compose use http://api:8000.
# When Next.js runs directly on your laptop use http://127.0.0.1:8000.
ECOTWIN_API_INTERNAL_URL=http://127.0.0.1:8000

# The public, read-only planning workspace needs no account or bearer token.

# Browser-visible harmless appearance setting; NOT an API key.
NEXT_PUBLIC_APP_LABEL=EcoTwin

# Optional local-only research explanation (calculations work without Ollama).
# An installed Gemma/Qwen model is auto-selected when OLLAMA_MODEL is empty.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional HTTPS CloudFront/S3 origin for public map assets; build-time setting.
# Empty uses bundled public/maps assets. Scientific data use the backend object store.
NEXT_PUBLIC_MAP_ASSET_BASE_URL=
MAP_CACHE_DIR=../data/cache/maps
