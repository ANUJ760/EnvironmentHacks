APP_ENV=production
APP_BASE_URL=https://planner.YOUR_DOMAIN
ECOTWIN_API_INTERNAL_URL=http://api.ecotwin-production.internal:8000
NEXT_PUBLIC_APP_LABEL=EcoTwin
# Build-time optional public CDN for the generated tree asset; empty = bundled.
NEXT_PUBLIC_MAP_ASSET_BASE_URL=
# Disposable visual tile cache only; scientific inputs are in private S3/PostGIS.
MAP_CACHE_DIR=/tmp/ecotwin-map-cache
# Optional same-task/local Ollama; do not expose 11434 to the internet.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
