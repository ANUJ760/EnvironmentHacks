{
  "name": "ecotwin-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/lib/api-types.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/lib/api-types.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^6.13.0",
    "next": "^15.2.1",
    "next-auth": "^4.24.15",
    "openapi-fetch": "^0.13.8",
    "pixi.js": "^8.22.0",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}
